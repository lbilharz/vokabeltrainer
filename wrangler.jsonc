{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "travok",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",

  // Die eigene Adresse. Die Domain ist bei Vercel gekauft, die DNS-Zone liegt bei Cloudflare.
  // Passkeys hängen an dieser Adresse. Ein Wechsel heisst: alle legen einen neuen Passkey an.
  "routes": [{ "pattern": "vok.cards", "custom_domain": true }],
  // Die Adresse unter workers.dev ist aus. Ein Passkey von dort würde auf vok.cards nicht gelten.
  "workers_dev": false,

  // Assets werden vom Vite-Plugin gebaut und eingehängt, daher kein "directory".
  // run_worker_first ist explizit, damit das Routing nicht am Sec-Fetch-Mode-Header hängt.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Die Datenbank wurde von Hand mit "--jurisdiction eu" angelegt.
  // Damit bleiben die Daten in der EU. Automatisches Anlegen beim Deploy
  // nimmt keinen Standort entgegen, und umziehen kann man D1 hinterher nicht.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travok-db",
      "database_id": "ebac8b43-42b6-40ed-a33b-1d84cad23d34",
      "migrations_dir": "./migrations"
    }
  ],

  // Aufnahmen für neu fotografierte Wörter. Der Bucket wurde von Hand in der EU angelegt.
  // Ohne "jurisdiction" sucht die Bindung im normalen Namensraum und findet ihn nicht.
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "travok-audio",
      "jurisdiction": "eu"
    }
  ],

  // Alle 15 Minuten. Der Worker prüft selbst die Ortszeit in Berlin und erinnert zur gewählten Viertelstunde.
  // Crons laufen in UTC. So muss niemand zweimal im Jahr an die Sommerzeit denken.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  "observability": {
    "enabled": true
  }
}
