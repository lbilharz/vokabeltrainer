{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "travok",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",

  // Assets werden vom Vite-Plugin gebaut und eingehängt, daher kein "directory".
  // run_worker_first ist explizit, damit das Routing nicht am Sec-Fetch-Mode-Header hängt.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Die Datenbank wurde von Hand mit "--jurisdiction eu" angelegt.
  // Damit bleiben die Daten in der EU. Automatisches Anlegen beim Deploy
  // nimmt keinen Standort entgegen, und umziehen kann man D1 hinterher nicht.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travok-db",
      "database_id": "ebac8b43-42b6-40ed-a33b-1d84cad23d34",
      "migrations_dir": "./migrations"
    }
  ],

  "observability": {
    "enabled": true
  }
}
