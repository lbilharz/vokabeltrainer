{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts"],

    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  // Aus shared/ importiert der Worker nur die Zusammenführung der Fotoerkennung samt ihren Abhängigkeiten.
  "include": ["worker", "shared/extract.ts", "shared/text.ts", "shared/types.ts", "shared/reminder.ts", "shared/version.ts"]
}
