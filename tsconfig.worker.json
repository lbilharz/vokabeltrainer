{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts"],

    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  // Aus shared/ stehen hier nur die Dateien, die der Worker importiert.
  "include": [
    "worker",
    "shared/base64.ts",
    "shared/dates.ts",
    "shared/extract.ts",
    "shared/lang.ts",
    "shared/limits.ts",
    "shared/reminder.ts",
    "shared/text.ts",
    "shared/types.ts",
    "shared/version.ts"
  ]
}
